    },
    {
      "cell_type": "code",
      "source": [
        "import pandas as pd\n",
        "from ucimlrepo import fetch_ucirepo\n",
        "\n",
        "df_raw = pd.read_csv(\"../data/ai4i2020.csv\")\n",
        "\n",
        "print(\"Shape:\", df_raw.shape) \n",
        "print(\"Columns:\", df_raw.columns.tolist()) \n",
        "df_raw.head()\n"
      ],
      "outputs": [
        {
          "output_type": "stream",
